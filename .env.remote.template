# 🚀 VERIZON CLASS ACTION - CONFIGURACIÓN SERVIDOR REMOTO
# Copiar a .env y completar con valores reales

# === CONFIGURACIÓN BÁSICA ===
DOMAIN=your-domain.com
ACME_EMAIL=admin@your-domain.com
NODE_ENV=production

# === BASE DE DATOS ===
DB_USER=postgres
DB_PASSWORD=YOUR_SECURE_DB_PASSWORD_HERE
DB_NAME=verizonunlock

# === SMTP/EMAIL ===
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=legal@your-domain.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD_HERE
SMTP_SECURE=false

# === SEGURIDAD ===
JWT_SECRET=your-jwt-secret-256-bit-key
EXPORT_SECRET=your-export-secret-token
ADMIN_PASSWORD=your-secure-admin-password

# === RATE LIMITING ===
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# === MONITORING ===
GRAFANA_PASSWORD=your-grafana-password

# === BACKUPS ===
BACKUP_SCHEDULE=0 2 * * *

# === SEGURIDAD ===
SCAN_INTERVAL=3600
SECURITY_WEBHOOK=https://your-webhook-url.com/alerts

# === SSH REMOTO (para deployment) ===
REMOTE_HOST=your-server-ip-or-domain
REMOTE_USER=root
SSH_KEY_PATH=~/.ssh/id_rsa
